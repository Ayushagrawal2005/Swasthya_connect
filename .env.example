# Backend API URLs (Production - Render)
VITE_API_URL=https://swasthya-connect-1x6r.onrender.com
VITE_ML_API_URL=https://swasthya-connect-ml.onrender.com
VITE_OCR_API_URL=https://swasthya-connect-ocr.onrender.com

# Feature flags
VITE_USE_ML_TRIAGE=true
VITE_USE_FALLBACK_SCORING=true

# Voice Triage System
# The voice triage demo is available at: public/voice-triage.html
# Backend configuration is in services/ml/.env (copy from services/ml/.env.example)
