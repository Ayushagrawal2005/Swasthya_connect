# ML Backend API
VITE_ML_API_URL=http://localhost:5000

# Feature flags
VITE_USE_ML_TRIAGE=true
VITE_USE_FALLBACK_SCORING=true
# Voice Triage System
# The voice triage demo is available at: public/voice-triage.html
# Backend configuration is in services/ml/.env (copy from services/ml/.env.example)
# IMPORTANT: GROQ_API_KEY must be set in services/ml/.env for voice triage to work
# Get your Groq API key from: https://console.groq.com/keys
