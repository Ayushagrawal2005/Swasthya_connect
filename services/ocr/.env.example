# Copy this file to .env and fill in your values

# Get a free key at https://aistudio.google.com -> "Get API key"
# No credit card required for the free tier.
GEMINI_API_KEY=

# Set to true to skip real OCR entirely and use canned demo data —
# useful while building/testing the rest of the app before you have
# a Gemini key, or as a guaranteed-to-work demo fallback.
OCR_MOCK_MODE=false
