# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=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

# Groq Model Configuration (optional)
# Available models:
# - llama-3.3-70b-versatile (default, best quality, multilingual)
# - llama-3.1-8b-instant (faster, lower latency)
# - mixtral-8x7b-32768 (alternative multilingual model)
GROQ_MODEL=openai/gpt-oss-120b

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Security
# WARNING: Never commit your actual .env file with real API keys!
# Keep GROQ_API_KEY server-side only - NEVER expose to frontend
